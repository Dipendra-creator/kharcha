# Copy to .env (Expo loads EXPO_PUBLIC_* at build/start time).

# Kharcha API. Defaults: http://10.0.2.2:8080 (Android emulator), http://localhost:8080 (iOS simulator).
EXPO_PUBLIC_API_URL=

# Google Sign-In + Gmail (see README → Google Cloud setup). Leave empty to build without it.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# com.googleusercontent.apps.<id> — enables the Google Sign-In config plugin (app.config.ts)
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
