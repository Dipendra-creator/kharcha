# Copy to deploy/.env. Generate secrets with: openssl rand -base64 32
KHARCHA_PORT=8090
POSTGRES_PASSWORD=
KHARCHA_JWT_SECRET=
KHARCHA_ENCRYPTION_KEY=

# none = no sign-in; every request uses one built-in owner account (private, single-user only).
# token = Google / dev sign-in with session tokens.
KHARCHA_AUTH_MODE=none

# LLM (optional; without one, uncertain SMS go to the app's Review inbox)
KHARCHA_LLM_PROVIDERS=anthropic,openai
ANTHROPIC_API_KEY=
KHARCHA_ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
KHARCHA_OPENAI_MODEL=gpt-5

# Gmail (optional)
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
GOOGLE_CLIENT_IDS=
