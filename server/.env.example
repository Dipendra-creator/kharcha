# Copy to .env and fill in. `make run` loads it.

KHARCHA_ADDR=:8080
DATABASE_URL=postgres://kharcha:kharcha@localhost:5432/kharcha?sslmode=disable
# Optional: without it, jobs run on an in-process queue (fine for one instance).
REDIS_URL=redis://localhost:6379/0

# Required in production. Generate with: openssl rand -base64 32
KHARCHA_JWT_SECRET=
KHARCHA_ENCRYPTION_KEY=
# true = email-only sign-in at POST /v1/auth/dev and insecure dev secrets. Never in production.
KHARCHA_DEV_LOGIN=false

# ── LLM ──────────────────────────────────────────────────────────────────────
# Tried in order; a provider without credentials is skipped.
# anthropic | openai | claude-cli | codex-cli
KHARCHA_LLM_PROVIDERS=anthropic,openai
ANTHROPIC_API_KEY=
KHARCHA_ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
KHARCHA_OPENAI_MODEL=gpt-5
# Local CLIs (dev): uses your logged-in Claude Code / Codex session. Slow and costly per call.
KHARCHA_CLAUDE_CLI=claude
KHARCHA_CLAUDE_CLI_MODEL=
KHARCHA_CODEX_CLI=codex
KHARCHA_CODEX_CLI_MODEL=
KHARCHA_LLM_TIMEOUT=90s

# ── Google (sign-in + Gmail read-only) ───────────────────────────────────────
# Web OAuth client: the app requests a server auth code for it; the server exchanges it.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
# All client ids whose ID tokens are accepted (web, Android, iOS), comma-separated.
GOOGLE_CLIENT_IDS=

KHARCHA_EMAIL_SYNC_EVERY=3h
KHARCHA_EMAIL_LOOKBACK=1080h
